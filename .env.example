# Auth
AUTH_SECRET=****

# Storage
BLOB_READ_WRITE_TOKEN=****

# AI Model Access
FIREWORKS_API_KEY=****
OPENAI_API_KEY=****

# Database Configuration
DATABASE_URL=file:./local.db
POSTGRES_URL=****

# Embedding Provider Configuration
# Options: 'ollama' or 'google'
# IMPORTANT: If changing providers with different vector dimensions, run 'pnpm db:migrate' 
# to update the database schema accordingly
EMBEDDING_PROVIDER=ollama

# Ollama Configuration (when EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text  # 768 dimensions

# Google AI Configuration (when EMBEDDING_PROVIDER=google)
GOOGLE_API_KEY=****
GOOGLE_EMBEDDINGS_MODEL=embedding-001    # 768 dimensions